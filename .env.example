# Copy this file to .env and adjust if needed.
# Everything works out of the box with the defaults.

# Secret used to sign JWTs. MUST be at least 32 characters long.
# Change this before going to production!
JWT_SECRET=change-me-before-going-to-production-32ch

# Port the app is served on (http://localhost:5173)
FRONTEND_PORT=5173

# Allowed CORS origin for API requests
CORS_ORIGIN=http://localhost:5173

# JWT lifetime
JWT_EXPIRES_IN=7d

# Backend log level (info | debug | warn | error)
LOG_LEVEL=info