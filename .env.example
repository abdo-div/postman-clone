# Server Configuration
PORT=5000
NODE_ENV=development

# Security & CORS
CORS_ORIGIN=*

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/api-client

# Redis Connection (optional / for queue runner)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
