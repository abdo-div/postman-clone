server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml image/png image/jpeg;
    gzip_min_length 1024;

    # Allow multipart/form-data uploads (large files)
    client_max_body_size 50m;

    # API -> backend service. BACKEND_HOST is injected at container start
    # (e.g. "backend" in docker-compose, "xxx.railway.internal" on Railway).
    location /api/ {
        proxy_pass http://$BACKEND_HOST:5000$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
    }

    # Hashed assets -> cache aggressively
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}